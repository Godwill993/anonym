# Copy this file to .env and fill in your Supabase project values.
# NEVER commit the .env file to source control.

# From Supabase > Settings > API > Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# From Supabase > Settings > API > anon / public key
# (either name works — supabase.js accepts both)
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Public Web Push VAPID key (safe to expose to browsers).
# Configure its matching private key as a Supabase Edge Function secret.
VITE_VAPID_PUBLIC_KEY=

# Optional: webhook for email/SMS (admission, fees). POST JSON { type, to, subject, body, meta }
VITE_NOTIFY_WEBHOOK_URL=

# Demo only — if true, student fee payments complete immediately (not for production)
# VITE_PAYMENTS_AUTO_COMPLETE=true
